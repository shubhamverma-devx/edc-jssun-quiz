# ------------------------------------------------------------------
# edc-jssun-quiz environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ------------------------------------------------------------------

# SUPABASE
# Get these from: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET - bypasses RLS. Server-only; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# CLOUDINARY
# Get these from: Cloudinary dashboard -> API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# SECRET - server-only; used for signed uploads and deletions.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SITE
# Base URL of the app. http://localhost:3000 in dev, your domain in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
